{
    "info": {
        "name": "PantryDetails API",
        "description": "Run Auth → Login (admin) first. The token is saved automatically and used by every request.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "folderId",
            "value": "1"
        },
        {
            "key": "itemId",
            "value": "1"
        },
        {
            "key": "userId",
            "value": "2"
        },
        {
            "key": "roleId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login (admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@pantrydetails.local\",\n    \"password\": \"Admin1234!\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.data && json.data.token) {",
                                    "    pm.collectionVariables.set(\"token\", json.data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login (user)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
